PORT=4000
JWT_SECRET=replace-with-a-long-random-string

# MongoDB Atlas connection string.
# Get this from Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <password> with your actual database user password, and add a
# database name at the end (before the "?") — e.g. "/wanderlust".
#
# Example:
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/wanderlust?retryWrites=true&w=majority
MONGODB_URI=
